# ─── Aliyun SMS Config ───
# 生产环境通过服务器环境变量注入，不要在此写入真实密钥
# 开发测试如需真实发送，配置 AK/SK 并设置 SMS_MODE=real
ALIYUN_ACCESS_KEY=
ALIYUN_ACCESS_SECRET=
SMS_SIGN_NAME=恒创联众
SMS_TEMPLATE_CODE=100001

# ─── SMS Mode ───
# dev:         开发模式，不调用阿里云，返回测试验证码
# real:        真实测试模式，调用阿里云 API，失败时降级返回开发验证码
# production:  生产模式，调用阿里云 API，失败时严格报错
SMS_MODE=production

# ─── JWT Secret ───
# 生产环境通过环境变量注入；不设置时服务器自动生成随机密钥
# JWT_SECRET=

# ─── Server ───
PORT=3001

# ─── Email SMTP (for email binding) ───
# 开发环境无需配置，仅 console.log
# 生产环境配置以下变量
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=WristLab <your-email@gmail.com>

# ─── CORS ───
# 多个 origin 用逗号分隔
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ─── Frontend API Base ───
VITE_API_BASE=http://localhost:3001/api
